<p class="hint">{{localize 'FU.FultimatorImportDescription'}}</p>
<div class="form-group">
	<label for="fultimator-import-files">{{localize 'FU.FultimatorImportFiles'}}</label>
	<input type="file" id="fultimator-import-files" name="files" accept=".json,application/json" multiple />
</div>
<div class="form-group stacked">
	<label for="fultimator-import-json">{{localize 'FU.FultimatorImportPaste'}}</label>
	<textarea id="fultimator-import-json" name="json" rows="6" spellcheck="false"></textarea>
</div>
<div class="form-group">
	<label for="fultimator-import-compendium">{{localize 'FU.FultimatorImportPreferCompendium'}}</label>
	<input type="checkbox" id="fultimator-import-compendium" name="preferCompendium" checked />
	<p class="hint">{{localize 'FU.FultimatorImportPreferCompendiumHint'}}</p>
</div>
